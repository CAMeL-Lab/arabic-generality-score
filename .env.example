# Copy to .env and adjust. All variables are optional.

# Where pipeline artifacts (probability tables, reformatted alignments, AGS scores) are
# read from / written to. Defaults to ./output relative to the repo root.
# AGS_OUTPUT_DIR=output

# Override the bundled CAPHI table used by distance_function/substitution_weight.py.
# AGS_CAPHI_TABLE=distance_function/data/CAPHI/CAPHI-table.tsv

# Only needed if you pass --wandb-project to an AGS_training script.
# WANDB_API_KEY=

# Only needed for `python -m AGS_evaluation.export_to_hf --push`.
# HF_TOKEN=
